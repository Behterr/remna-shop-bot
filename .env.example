# ============================================================
# Основные настройки Telegram-бота
# ============================================================
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Режим получения обновлений: polling (по умолчанию) или webhook
BOT_MODE=polling
# Секретный токен для заголовка X-Telegram-Bot-Api-Secret-Token в webhook-режиме
BOT_WEBHOOK_SECRET=change_me_random_secret
# ID администраторов через запятую (можно узнать у @userinfobot)
ADMIN_IDS=123456789
# Задержка между сообщениями пользователя для защиты от спама (в секундах)
THROTTLE_RATE_LIMIT=0.6

# ============================================================
# Веб-сервер и вебхуки (FastAPI + uvicorn)
# ============================================================
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный HTTPS-домен для вебхуков платежек и редиректа /connect/{app}
# Пример: https://bot.example.com (оставьте пустым, если домен еще не подключен)
WEBHOOK_DOMAIN=

# ============================================================
# База данных PostgreSQL и Redis
# ============================================================
POSTGRES_DB=remnabot
POSTGRES_USER=remnabot
POSTGRES_PASSWORD=change_me_strong_pg_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://remnabot:change_me_strong_pg_password@postgres:5432/remnabot

REDIS_PASSWORD=change_me_strong_redis_password
REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0

# ============================================================
# Интеграция с панелью Remnawave
# ============================================================
# Внешний HTTPS URL (https://panel.example.com) или внутренний Docker URL (http://remnawave:3000)
REMNAWAVE_URL=http://remnawave:3000
# API-токен из настроек Remnawave (Settings -> API Tokens)
REMNAWAVE_API_TOKEN=change_me_remnawave_api_token
REMNAWAVE_API_TIMEOUT=15.0
REMNAWAVE_API_RETRIES=3
# Стратегия сброса трафика по умолчанию: NO_RESET, DAY, WEEK, MONTH
REMNAWAVE_TRAFFIC_STRATEGY=NO_RESET
# UUID внутренних сквадов по умолчанию через запятую (используются для триала и как запасной вариант)
REMNAWAVE_DEFAULT_SQUADS=

# ============================================================
# Пробный период (значения по умолчанию; редактируются и в админке)
# ============================================================
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=3
TRIAL_TRAFFIC_GB=10
TRIAL_DEVICE_LIMIT=2

# ============================================================
# Реферальная программа (редактируется в .env и в админке)
# ============================================================
REFERRAL_ENABLED=true
# Тип награды: percent (% на баланс от оплаты реферала) или days (бонусные дни к подписке)
REFERRAL_REWARD_TYPE=percent
REFERRAL_REWARD_PERCENT=15
REFERRAL_REWARD_DAYS=5
# Начислять бонус только за первую оплату реферала (true/false)
REFERRAL_FIRST_PAYMENT_ONLY=false

# ============================================================
# Платежные провайдеры (оставьте пустым для отключения провайдера)
# ============================================================
# Курс RUB за 1 Telegram Star (если в тарифе price_stars не задан явно)
STARS_RUB_RATE=1.8

# CryptoBot (@CryptoBot / Crypto Pay API)
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
CRYPTOBOT_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,LTC,TRX,USDC

# YooKassa (API v3)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# URL возврата после оплаты (если пустой — используется ссылка на бота)
YOOKASSA_RETURN_URL=
# Доверять входящему вебхуку без доп. проверки GET /v3/payments/{id} (в production держать false!)
YOOKASSA_TRUST_WEBHOOK_WITHOUT_API_CHECK=false

# ============================================================
# Поддержка и планировщик фоновых задач
# ============================================================
SUPPORT_URL=https://t.me/your_support
SUPPORT_TEXT=Если у вас возникли вопросы по подключению или оплате, напишите в нашу поддержку.

# Интервалы проверки (в минутах)
SCHEDULER_EXPIRY_INTERVAL_MINUTES=5
SCHEDULER_TRAFFIC_INTERVAL_MINUTES=10

# Автоочистка просроченных пользователей в Remnawave
ENABLE_EXPIRED_CLEANUP=false
EXPIRED_CLEANUP_DAYS=14

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
